# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://syed:postgres@localhost:5432/eduflow
POSTGRES_USER=syed
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eduflow

# Backend API Configuration
SECRET_KEY=eduflow_super_secret_jwt_key_development_2026
PORT=8000

# Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=eduflow_auth_secret_key_production_32_chars_long!
AUTH_URL=http://localhost:3000
