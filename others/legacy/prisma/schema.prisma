generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  OWNER
  TEACHER
  STUDENT
  PARENT // Reserved for future extension
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentMethod {
  BKASH
  NAGAD
  CASH
  BANK_TRANSFER
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}

// ==========================================
// MODELS (MULTI-TENANT BY institute_id)
// ==========================================

model Institute {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  phone     String?
  email     String?
  address   String?
  logoUrl   String?  @map("logo_url")
  subdomain       String?  @unique
  currency        String?  @default("BDT")
  timezone        String?  @default("Asia/Dhaka")
  defaultLanguage String?  @default("en") @map("default_language")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Multi-tenant relations
  users          User[]
  teachers       Teacher[]
  students       Student[]
  batches        Batch[]
  studentBatches StudentBatch[]
  attendances    Attendance[]
  fees           Fee[]
  results        Result[]
  expenses       Expense[]
  activityLogs   ActivityLog[]

  @@map("institutes")
}

model User {
  id           String    @id @default(cuid())
  instituteId  String    @map("institute_id")
  name         String
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         Role      @default(STUDENT)
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacher      Teacher?
  student      Student?
  accounts     Account[]
  sessions     Session[]
  activityLogs ActivityLog[]

  @@index([instituteId])
  @@map("users")
}

// Auth.js Session & Account tables for database session strategy
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Teacher {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  userId      String   @unique @map("user_id")
  subject     String
  phone       String?
  joiningDate DateTime @default(now()) @map("joining_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches   Batch[]

  @@index([instituteId])
  @@map("teachers")
}

model Student {
  id            String        @id @default(cuid())
  instituteId   String        @map("institute_id")
  userId        String?       @unique @map("user_id")
  rollNo        String        @map("roll_no")
  fullName      String        @map("full_name")
  email         String?
  gender        String?
  bloodGroup    String?       @map("blood_group")
  dateOfBirth   DateTime?     @map("date_of_birth")
  guardianName  String?       @map("guardian_name")
  guardianPhone String?       @map("guardian_phone")
  address       String?
  photoUrl      String?       @map("photo_url")
  status        StudentStatus @default(ACTIVE)
  admissionDate DateTime      @default(now()) @map("admission_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  institute      Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentBatches StudentBatch[]
  attendances    Attendance[]
  fees           Fee[]
  results        Result[]

  @@unique([instituteId, rollNo])
  @@index([instituteId])
  @@map("students")
}

model Batch {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  teacherId   String?  @map("teacher_id")
  name        String
  subject     String?
  schedule    String?
  monthlyFee  Decimal  @default(0.00) @map("monthly_fee") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute      Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacher        Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  studentBatches StudentBatch[]
  attendances    Attendance[]
  results        Result[]

  @@index([instituteId])
  @@index([teacherId])
  @@map("batches")
}

model StudentBatch {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  studentId   String   @map("student_id")
  batchId     String   @map("batch_id")
  enrolledAt  DateTime @default(now()) @map("enrolled_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId])
  @@index([instituteId])
  @@map("student_batches")
}

model Attendance {
  id          String           @id @default(cuid())
  instituteId String           @map("institute_id")
  studentId   String           @map("student_id")
  batchId     String           @map("batch_id")
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  markedBy    String?          @map("marked_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId, date])
  @@index([instituteId])
  @@index([batchId, date])
  @@map("attendances")
}

model Fee {
  id            String        @id @default(cuid())
  instituteId   String        @map("institute_id")
  studentId     String        @map("student_id")
  receiptNo     String        @map("receipt_no")
  amount        Decimal       @db.Decimal(10, 2)
  monthYear     String        @map("month_year")
  status        FeeStatus     @default(PENDING)
  paymentMethod PaymentMethod? @map("payment_method")
  transactionId String?       @map("transaction_id")
  paymentDate   DateTime?     @map("payment_date")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([studentId])
  @@map("fees")
}

model Result {
  id            String    @id @default(cuid())
  instituteId   String    @map("institute_id")
  studentId     String    @map("student_id")
  batchId       String    @map("batch_id")
  examName      String    @map("exam_name")
  subject       String
  marksObtained Decimal   @map("marks_obtained") @db.Decimal(5, 2)
  totalMarks    Decimal   @default(100.00) @map("total_marks") @db.Decimal(5, 2)
  grade         String?
  examDate      DateTime? @map("exam_date")
  comments      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([studentId])
  @@index([batchId])
  @@map("results")
}

model Expense {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  title       String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  expenseDate DateTime @default(now()) @map("expense_date")
  notes       String?
  recordedBy  String?  @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("expenses")
}

model ActivityLog {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  userId      String?  @map("user_id")
  action      String
  details     String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@map("activity_logs")
}
