# Neon PostgreSQL Database Connection String
# Obtain this connection URL from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-something.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth Secret
# Generate a secret via `openssl rand -base64 32` or any random string
AUTH_SECRET="your_production_auth_secret_here"

# NextAuth Canonical Application URL
# Set this to your Vercel deployment domain (e.g., https://your-app.vercel.app)
NEXTAUTH_URL="https://your-app.vercel.app"
